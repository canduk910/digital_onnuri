# ── NCP 배포용 환경변수 템플릿 ──
# 실제 값을 채운 파일은 반드시 `.env`로 저장하고 서버에만 둔다. 저장소에 커밋 금지(.gitignore 처리됨).
#   cp .env.example .env  후 값 입력

# DB (같은 VM의 Postgres 컨테이너). DB_URL 호스트는 컨테이너명 "db".
DB_NAME=onnuri
DB_USER=onnuri
DB_PASSWORD=__여기에_DB_비밀번호__
DB_URL=jdbc:postgresql://db:5432/onnuri

# 백엔드 공개 도메인 — Caddy가 이 도메인으로 자동 TLS 발급
API_DOMAIN=api.koscomlabor.cloud

# Let's Encrypt 인증서 관련 알림 이메일
TLS_EMAIL=you@example.com

# (선택) CORS 허용 오리진 override. 미설정 시 앱 기본값에 https://canduk910.github.io 포함.
# APP_CORS_ALLOWED_ORIGINS=https://canduk910.github.io

# 챗봇(ADR-12) — OpenAI API 키. 챗 기능을 켤 때만 필요(미설정 시 챗만 비활성).
# 키는 이 서버 .env에만 둔다. 채팅·저장소·프론트에 절대 붙여넣지 않는다.
OPENAI_API_KEY=
